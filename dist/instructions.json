{
  "name": "powerup-hello-world",
  "type": "single-use",
  "description": "A powerup useful for testing",
  "variables": {
    "required": [
      "name"
    ],
    "optional": [
      "description"
    ]
  },
  "intent": [],
  "steps": [
    {
      "name": "Hello World",
      "type": "dynamic-create",
      "template": "src/dynamic-create/index.ts",
      "outputPath": "index.ts"
    },
    {
      "name": "package.json",
      "type": "dynamic-create",
      "template": "src/dynamic-create/packageJson.ts",
      "outputPath": "package.json"
    }
  ]
}
